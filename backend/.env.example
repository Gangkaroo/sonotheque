APP_NAME="Music Library"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=music_library
DB_USERNAME=music_library
DB_PASSWORD=music_library
DB_SSLMODE=disable

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
ARTWORK_DISK=artwork
ARTWORK_THUMBNAIL_WIDTH=320
ARTWORK_THUMBNAIL_HEIGHT=320
ARTWORK_THUMBNAIL_QUALITY=82
ARTWORK_MAX_SOURCE_BYTES=26214400
ARTWORK_MAX_SOURCE_PIXELS=40000000
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=86400
SCAN_MEMORY_LIMIT=1024M
SCAN_STALE_AFTER_MINUTES=15
PLAY_STATISTICS_MINIMUM_TRACK_SECONDS=30
PLAY_STATISTICS_MAXIMUM_THRESHOLD_SECONDS=240
AUDIO_STREAM_OPEN_ENDED_RANGE_BYTES=2097152
LASTFM_API_URL=https://ws.audioscrobbler.com/2.0/
LASTFM_AUTH_URL=https://www.last.fm/api/auth/
LASTFM_TIMEOUT_SECONDS=10
# Leave empty for a direct connection. Set only when your network requires a proxy.
LASTFM_PROXY=
# Set this when PHP has no curl.cainfo/openssl.cafile configured.
LASTFM_CA_BUNDLE=
ENRICHMENT_USER_AGENT="MusicLibrary/0.1 (local music library application)"
ENRICHMENT_CA_BUNDLE=
ENRICHMENT_READY_CACHE_DAYS=30
ENRICHMENT_STALE_CACHE_DAYS=7
ENRICHMENT_NOT_FOUND_CACHE_HOURS=24
ENRICHMENT_ERROR_RETRY_MINUTES=15
ENRICHMENT_MAX_ERROR_RETRY_MINUTES=360
ENRICHMENT_LOCK_SECONDS=30
ENRICHMENT_LOCK_WAIT_SECONDS=12
LASTFM_ENRICHMENT_REQUESTS_PER_MINUTE=30
LRCLIB_REQUESTS_PER_MINUTE=60
MUSICBRAINZ_REQUESTS_PER_MINUTE=55
MUSICBRAINZ_MINIMUM_INTERVAL_MS=1100
LRCLIB_API_URL=https://lrclib.net/api
LRCLIB_TIMEOUT_SECONDS=20
# LRCLIB uses direct HTTPS by default and can be configured separately from Last.fm.
LRCLIB_PROXY=
LRCLIB_CA_BUNDLE=
MUSICBRAINZ_API_URL=https://musicbrainz.org/ws/2
MUSICBRAINZ_WEB_URL=https://musicbrainz.org
MUSICBRAINZ_USER_AGENT="MusicLibrary/0.1 (https://github.com/Gangkaroo/music-library)"
MUSICBRAINZ_TIMEOUT_SECONDS=20
MUSICBRAINZ_PROXY=
MUSICBRAINZ_CA_BUNDLE=
MUSICBRAINZ_MINIMUM_MATCH_SCORE=95
MUSICBRAINZ_AMBIGUITY_SCORE_GAP=10
WIKIMEDIA_REQUESTS_PER_MINUTE=30
WIKIDATA_QUERY_URL=https://query.wikidata.org/sparql
WIKIMEDIA_COMMONS_API_URL=https://commons.wikimedia.org/w/api.php
WIKIMEDIA_USER_AGENT="MusicLibrary/0.1 (https://github.com/Gangkaroo/music-library)"
WIKIMEDIA_TIMEOUT_SECONDS=20
WIKIMEDIA_PROXY=
WIKIMEDIA_CA_BUNDLE=
# The startup script overrides LAN_ENABLED and augments TRUSTED_HOSTS in -Lan mode.
MUSIC_LIBRARY_LAN_ENABLED=false
# Required for -Lan startup; use at least 32 random characters and do not commit it.
MUSIC_LIBRARY_ADMIN_TOKEN=
MUSIC_LIBRARY_TRUSTED_HOSTS=localhost,127.0.0.1,::1
MUSIC_LIBRARY_ALLOWED_ORIGINS=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
