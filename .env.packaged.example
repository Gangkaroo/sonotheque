# Copy this file to .env.packaged before using compose.packaged.yaml.
#
# Generate APP_KEY once and keep it stable:
#   docker run --rm php:8.5-cli-alpine php -r "echo 'base64:'.base64_encode(random_bytes(32)), PHP_EOL;"

APP_KEY=
APP_HTTP_BIND=127.0.0.1
APP_HTTP_PORT=8080
APP_URL=http://127.0.0.1:8080
CACHE_STORE=file
CACHE_SERIALIZABLE_CLASSES=true

POSTGRES_DB=sonotheque
POSTGRES_USER=sonotheque
POSTGRES_PASSWORD=change-this-local-password

# The first packaged music mount. Replace this with a real host folder.
# Windows examples:
#   SONOTHEQUE_ROOT_1=G:\Music
#   SONOTHEQUE_ROOT_1=H:\Archive
#
# Inside the app, this folder is visible as:
#   /music/root-1
SONOTHEQUE_ROOT_1=./packaged/music-root-1

# LAN mode remains explicit. Keep disabled for normal localhost use.
SONOTHEQUE_LAN_ENABLED=false
SONOTHEQUE_LOCAL_PROXY_ENABLED=true
SONOTHEQUE_ADMIN_TOKEN=
SONOTHEQUE_TRUSTED_HOSTS=localhost,127.0.0.1,::1
SONOTHEQUE_ALLOWED_ORIGINS=

# Optional external-provider/network settings can be added here as needed.
LASTFM_API_URL=https://ws.audioscrobbler.com/2.0/
LASTFM_AUTH_URL=https://www.last.fm/api/auth/
DISCOGS_API_URL=https://api.discogs.com
DISCOGS_WEB_URL=https://www.discogs.com
DISCOGS_USER_AGENT="Sonotheque/0.1 (https://github.com/Gangkaroo/sonotheque)"
LRCLIB_API_URL=https://lrclib.net/api
MUSICBRAINZ_API_URL=https://musicbrainz.org/ws/2
MUSICBRAINZ_WEB_URL=https://musicbrainz.org
