# Copy this file to .env.packaged before using compose.packaged.yaml.
#
# Generate APP_KEY once and keep it stable:
#   docker run --rm php:8.5-cli-alpine php -r "echo 'base64:'.base64_encode(random_bytes(32)), PHP_EOL;"

APP_KEY=
APP_HTTP_BIND=127.0.0.1
APP_HTTP_PORT=8080
APP_URL=http://127.0.0.1:8080
CACHE_STORE=file
CACHE_SERIALIZABLE_CLASSES=true

# Filled automatically by the Linux/macOS launcher so files created in host
# music folders keep the desktop user's ownership. Leave empty on Windows.
SONOTHEQUE_HOST_UID=
SONOTHEQUE_HOST_GID=
SONOTHEQUE_DOCKER_GID=0

POSTGRES_DB=sonotheque
POSTGRES_USER=sonotheque
POSTGRES_PASSWORD=change-this-local-password

# The first packaged music mount. Replace this with a real host folder.
# Windows examples:
#   SONOTHEQUE_ROOT_1=G:\Music
#   SONOTHEQUE_ROOT_1=H:\Archive
#
# Inside the app, this folder is visible as:
#   /music/root-1
SONOTHEQUE_ROOT_1=./packaged/music-root-1

# LAN mode remains explicit. Keep disabled for normal localhost use.
SONOTHEQUE_LAN_ENABLED=false
SONOTHEQUE_LOCAL_PROXY_ENABLED=true
SONOTHEQUE_ADMIN_TOKEN=
SONOTHEQUE_TRUSTED_HOSTS=localhost,127.0.0.1,::1
SONOTHEQUE_ALLOWED_ORIGINS=

# Optional local collection assistant. Ollama runs on the Windows host; models
# are installed and managed by the user, never by Sonotheque.
COLLECTION_ASSISTANT_OLLAMA_URL=http://host.docker.internal:11434
COLLECTION_ASSISTANT_TIMEOUT_SECONDS=10
COLLECTION_ASSISTANT_TEST_TIMEOUT_SECONDS=120
COLLECTION_ASSISTANT_KEEP_ALIVE=15m
COLLECTION_ASSISTANT_CONTEXT_WINDOW=4096
COLLECTION_ASSISTANT_MAX_ANSWER_TOKENS=256
COLLECTION_ASSISTANT_RECOMMENDED_MODEL=qwen3:4b

# Optional local Audio Intelligence. Keep disabled until the reviewed model and
# analyzer image have been configured with Configure Sonotheque Audio Intelligence.cmd
# on Windows or ./sonotheque intelligence on Linux/macOS.
AUDIO_INTELLIGENCE_DRIVER=none
AUDIO_INTELLIGENCE_MODEL_DIRECTORY=./packaged/audio-intelligence
AUDIO_INTELLIGENCE_MODEL_FILENAME=model.pb
AUDIO_INTELLIGENCE_DOCKER_IMAGE=sonotheque-audio-intelligence:analysis
AUDIO_INTELLIGENCE_BENCHMARK_CPU_IMAGE=sonotheque-audio-intelligence:analysis
AUDIO_INTELLIGENCE_BENCHMARK_CUDA_IMAGE=sonotheque-audio-intelligence:cuda
AUDIO_INTELLIGENCE_ACCELERATOR=cpu
AUDIO_INTELLIGENCE_PERSISTENT=true
AUDIO_INTELLIGENCE_MOUNT_SOURCE_CONTAINER=self
AUDIO_INTELLIGENCE_HEALTH_VIA_QUEUE=true

# Optional external-provider/network settings can be added here as needed.
LASTFM_API_URL=https://ws.audioscrobbler.com/2.0/
LASTFM_AUTH_URL=https://www.last.fm/api/auth/
DISCOGS_API_URL=https://api.discogs.com
DISCOGS_WEB_URL=https://www.discogs.com
DISCOGS_USER_AGENT="Sonotheque/0.1 (https://github.com/Gangkaroo/sonotheque)"
LRCLIB_API_URL=https://lrclib.net/api
MUSICBRAINZ_API_URL=https://musicbrainz.org/ws/2
MUSICBRAINZ_REQUESTS_PER_MINUTE=40
MUSICBRAINZ_MINIMUM_INTERVAL_MS=1500
MUSICBRAINZ_COOLDOWN_SECONDS=60
MUSICBRAINZ_WEB_URL=https://musicbrainz.org
