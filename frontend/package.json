{
  "name": "sonotheque-frontend",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm-run-all type-check build-only",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --quiet",
    "test": "vitest run",
    "test:e2e:packaged": "playwright test",
    "test:e2e:packaged:headed": "playwright test --headed",
    "test:e2e:upgrade": "playwright test --config=playwright.config.upgrade.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mdi/font": "7.4.47",
    "@tiptap/pm": "^3.30.1",
    "@tiptap/starter-kit": "^3.30.1",
    "@tiptap/vue-3": "^3.30.1",
    "dompurify": "^3.4.13",
    "marked": "^18.0.9",
    "pinia": "3.0.4",
    "vue": "3.5.41",
    "vue-i18n": "11.4.8",
    "vue-router": "5.2.0",
    "vuetify": "4.1.9"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.62.1",
    "@tsconfig/node22": "22.0.6",
    "@types/node": "25.9.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "0.9.1",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.11.0",
    "jsdom": "28.1.0",
    "npm-run-all2": "8.0.4",
    "sass": "1.102.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vite-plugin-vuetify": "2.1.3",
    "vitest": "4.1.10",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.10"
  }
}
